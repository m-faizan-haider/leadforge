# LeadForge AI environment template
# Copy to .env and replace placeholder values.

# Runtime
APP_ENV=development
PORT=8000

# Required: database connection
# Local docker-compose example:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/leadforge
# Hosted production example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Required: comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required: token signing secret. Use a long random value in production.
AUTH_SECRET=replace_with_a_long_random_secret

# Scraper
# serpapi = production-safe Google Maps data provider
# playwright = local browser fallback scraper
SCRAPER_MODE=serpapi
SERPAPI_KEY=your_serpapi_key_here
REQUIRE_SERPAPI=false

# AI generation
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Optional enrichment
HUNTER_API_KEY=

# Proxy list for Playwright/requests fallback scraping
PROXY_URLS=

# Email sending
SIMULATE_EMAIL=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
